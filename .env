# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=sqlite:///./matrimony.db

# ============================================
# JWT AUTHENTICATION
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# REDIS CONFIGURATION (For OTP & Caching)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AWS S3 (Photo Upload - Optional)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=matrimony-photos
AWS_REGION=ap-south-1

# ============================================
# TWILIO SMS (Mobile OTP - Optional)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# EMAIL SMTP (Gmail - For Password Reset)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_16_digits
EMAIL_FROM=your_email@gmail.com

# ============================================
# APP SETTINGS
# ============================================
APP_NAME=Matrimony App
DEBUG=True
OTP_EXPIRY_MINUTES=5
MAX_PHOTO_SIZE_MB=5

# ============================================
# FEATURE TOGGLES (For Development)
# ============================================
# Set to True to actually send emails/SMS
EMAIL_ENABLED=False
SMS_ENABLED=False